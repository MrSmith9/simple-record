<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         LIGHT THEME (2026-10-07)
         A bright, high-contrast alternative to Theme.Dark.xaml, chosen in
         Settings > Appearance. Defines exactly the same key names as
         Theme.Dark.xaml (see that file for the full explanation of how
         theme-swapping works) - only the actual colors differ.

         The colors below are deliberately a little deeper/darker than
         Theme.Dark.xaml's equivalents (e.g. the accent blue, the record
         red, the purple and teal icon colors) - a color that reads clearly
         on a near-black background can look pale and washed-out on a
         white one, so each one was picked to stay easy to read against
         this theme's light background and surface colors specifically.
    ====================================================================== -->
    <Color x:Key="BackgroundColor">#FFEDEFF5</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="BorderColor">#FFD8DCE6</Color>
    <Color x:Key="AccentColor">#FF2563EB</Color>
    <Color x:Key="RecordColor">#FFDC2626</Color>
    <Color x:Key="TextPrimaryColor">#FF1A1B26</Color>
    <Color x:Key="TextSecondaryColor">#FF5B5F73</Color>
    <Color x:Key="DisabledColor">#FFE2E4EC</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="RecordBrush" Color="{StaticResource RecordColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}"/>

    <SolidColorBrush x:Key="IconPurpleBrush" Color="#FF9333EA"/>
    <SolidColorBrush x:Key="IconTealBrush" Color="#FF0D9488"/>

    <!-- 2026-10-08: see Theme.Dark.xaml's comment on this same key - BLACK
         here because this theme's surfaces are light/white, so darkening
         slightly on hover/press is what reads clearly (a white overlay,
         like Theme.Dark.xaml uses, would be invisible on a white button). -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="Black"/>

</ResourceDictionary>
