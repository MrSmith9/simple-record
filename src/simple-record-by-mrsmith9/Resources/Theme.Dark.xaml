<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         DARK THEME (2026-10-07)
         The app's original color palette, and the default theme. Every
         other file in the app (Styles.xaml, and every window's own XAML)
         refers to colors only by these key names (BackgroundBrush,
         SurfaceBrush, AccentBrush, and so on) rather than writing a color
         directly - that's what makes it possible to swap the whole app's
         look by swapping which of this file or Theme.Light.xaml is merged
         into the app's resources (see Services/ThemeManager.cs).

         IMPORTANT: this file and Theme.Light.xaml must always define
         exactly the same set of keys. If one of them is missing a key that
         a window's XAML uses, that window will fail to open (with a
         "resource not found" error) whenever that theme is active.
    ====================================================================== -->
    <Color x:Key="BackgroundColor">#FF14151F</Color>
    <Color x:Key="SurfaceColor">#FF1E2030</Color>
    <Color x:Key="BorderColor">#FF32354A</Color>
    <Color x:Key="AccentColor">#FF4F8EF7</Color>
    <Color x:Key="RecordColor">#FFE5484D</Color>
    <Color x:Key="TextPrimaryColor">#FFF5F5F7</Color>
    <Color x:Key="TextSecondaryColor">#FF9CA0B4</Color>
    <Color x:Key="DisabledColor">#FF2A2C3B</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="RecordBrush" Color="{StaticResource RecordColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}"/>

    <!-- Two extra accent colors used only for the small toolbar icons on
         the main window - "Whole Screen" keeps the normal AccentBrush,
         "A Window" uses purple, "Custom Area" uses teal, and "Record" uses
         the existing RecordBrush. Not used anywhere else in the app. -->
    <SolidColorBrush x:Key="IconPurpleBrush" Color="#FFA855F7"/>
    <SolidColorBrush x:Key="IconTealBrush" Color="#FF2DD4BF"/>

    <!-- 2026-10-08: the color a button/menu item "lights up" with on hover
         and press (see Styles.xaml's BaseButton/IconToolButton/
         TitleBarButton - a thin overlay of this color is drawn on top at
         8% opacity on hover, 16% on press). On this dark theme, surfaces
         are dark, so a WHITE overlay is what reads as "lighter" - Theme.
         Light.xaml uses BLACK for the same reason in reverse (a white
         overlay on an already-white button would be invisible). -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="White"/>

</ResourceDictionary>
