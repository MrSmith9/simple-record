<Window x:Class="SimpleRecord.Views.RegionBoundaryOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="False"
        ShowActivated="False">

    <!-- Just an outline, no fill - Background="Transparent" on the Border
         itself means the middle stays fully see-through, so only the red
         edge is visible, drawn exactly around the pixels being recorded. -->
    <Border BorderBrush="#FFFF3B30" BorderThickness="3" Background="Transparent"/>
</Window>
