<Window x:Class="SimpleRecord.Views.ConfirmStartDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start recording?"
        Icon="/Assets/AppIcon.ico"
        Width="480" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Start recording?" Style="{StaticResource HeadingText}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Style="{StaticResource BodyText}" TextWrapping="Wrap">
            <Run x:Name="SourceDescriptionRun" Text="This will record your whole screen."/>
            <LineBreak/><LineBreak/>
            <Run Text="Anything visible in that area - windows, notifications, anything you type or show - will be captured in the video file. Make sure nothing private is on screen before you continue."/>
        </TextBlock>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="_Cancel" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,12,0" Click="CancelButton_Click" IsCancel="True"/>
            <Button x:Name="ConfirmButton" Content="_Start Recording" Style="{StaticResource PrimaryButton}"
                    Click="ConfirmButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
