<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- RootNamespace is the C# code identifier (what every "namespace"
         line says) - it can't contain hyphens, so it's "SimpleRecord"
         rather than "simple-record-by-mrsmith9". AssemblyName is just the
         output file name (simple-record-by-mrsmith9.exe), which CAN use
         hyphens since it isn't C# code - these two are allowed to differ. -->
    <RootNamespace>SimpleRecord</RootNamespace>
    <AssemblyName>simple-record-by-mrsmith9</AssemblyName>

    <!-- ScreenRecorderLib wraps native Windows components, so this project
         must always build as x64, never "AnyCPU" - x64 matches almost
         every modern Windows PC, including yours. Setting <Platform> (not
         just <PlatformTarget>) is what makes this apply even when building
         from the command line with "dotnet build"/"dotnet publish" and no
         .sln file involved, which is what AnyCPU was slipping in from. -->
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>

    <AssemblyTitle>Simple Record</AssemblyTitle>
    <Product>Simple Record</Product>
    <Company>Kyle Smith</Company>
    <Copyright>© 2026 Kyle Smith. All rights reserved.</Copyright>
    <Version>0.9.3</Version>

    <!-- This is what gives the built .exe its icon - shown in File
         Explorer, and in the taskbar/Alt+Tab when SmartScreen/shell
         caching uses the file icon directly. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- MIT licensed. See THIRD_PARTY_NOTICES.md in the project root. -->
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same icon file as <ApplicationIcon> above, but also included here
         as a Resource so the running app's windows (title bar, taskbar)
         can load it directly - <ApplicationIcon> alone only covers the
         .exe file's own icon, not what WPF shows while the app is open. -->
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

</Project>
