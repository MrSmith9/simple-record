<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 2026-10-08: bumped from plain "net8.0-windows" to this more
         specific "versioned" Windows target so the app can call a few
         Windows-provided features directly from C# (Windows.Media.Editing,
         used by Services/ClipExporter.cs to build a short trimmed-video
         "clip" from a bookmark - see Services/ClipExporter.cs's own
         comment for what this feature is and why it needed this change).
         No extra NuGet package is needed for this - the .NET SDK makes
         these Windows APIs available to C# automatically whenever
         TargetFramework is one of these more specific
         "windowsX.0.XXXXX.0" versions, instead of the plain "-windows"
         used before. If Visual Studio says the matching Windows SDK
         version (10.0.19041.0) isn't installed, it will offer to install
         it automatically the first time you open/build this project -
         just say yes to that prompt. If the build instead fails saying
         it can't find the Windows.Media.Editing/Windows.Storage types,
         try adding the "Microsoft.Windows.SDK.Contracts" NuGet package
         (right-click the project in Solution Explorer -> Manage NuGet
         Packages -> Browse -> search for that exact name -> Install). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- This just means "compiled against the 10.0.19041.0 (Windows 10,
         May 2020 Update) API set" - it does NOT raise what Windows
         version the app needs to actually run. TargetPlatformMinVersion
         below is the real "oldest Windows this can run on" setting, kept
         the same as before this change. -->
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- RootNamespace is the C# code identifier (what every "namespace"
         line says) - it can't contain hyphens, so it's "SimpleRecord"
         rather than "simple-record-by-mrsmith9". AssemblyName is just the
         output file name (simple-record-by-mrsmith9.exe), which CAN use
         hyphens since it isn't C# code - these two are allowed to differ. -->
    <RootNamespace>SimpleRecord</RootNamespace>
    <AssemblyName>simple-record-by-mrsmith9</AssemblyName>

    <!-- ScreenRecorderLib wraps native Windows components, so this project
         must always build as x64, never "AnyCPU" - x64 matches almost
         every modern Windows PC, including yours. Setting <Platform> (not
         just <PlatformTarget>) is what makes this apply even when building
         from the command line with "dotnet build"/"dotnet publish" and no
         .sln file involved, which is what AnyCPU was slipping in from. -->
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>

    <AssemblyTitle>Simple Record</AssemblyTitle>
    <Product>Simple Record</Product>
    <Company>Kyle Smith</Company>
    <Copyright>© 2026 Kyle Smith. All rights reserved.</Copyright>
    <Version>0.11.0</Version>

    <!-- This is what gives the built .exe its icon - shown in File
         Explorer, and in the taskbar/Alt+Tab when SmartScreen/shell
         caching uses the file icon directly. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- MIT licensed. See THIRD_PARTY_NOTICES.md in the project root. -->
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <!-- Apache 2.0 licensed. Used only for the optional "Also save an
         animated GIF" setting (see Services/GifExporter.cs) - builds a
         .gif file from the periodic PNG snapshots ScreenRecorderLib
         captures alongside a video recording. See THIRD_PARTY_NOTICES.md. -->
    <PackageReference Include="Openize.Animated-GIF" Version="25.5.0" />
    <!-- Lets GifExporter.cs load the PNG snapshot files as images before
         handing them to Openize.Animated-GIF. Not included by default in
         .NET anymore (you have to reference it yourself) - safe to use
         here since this project already targets Windows only
         (net8.0-windows). -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same icon file as <ApplicationIcon> above, but also included here
         as a Resource so the running app's windows (title bar, taskbar)
         can load it directly - <ApplicationIcon> alone only covers the
         .exe file's own icon, not what WPF shows while the app is open. -->
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

</Project>
