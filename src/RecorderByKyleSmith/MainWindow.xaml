<Window x:Class="RecorderByKyleSmith.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording by Kyle Smith"
        Icon="/Assets/AppIcon.ico"
        Width="860" Height="580"
        MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <!-- Background image. Stretch="UniformToFill" crops it to fill the
             window at any size without distorting it. -->
        <Image Source="/Assets/AppBackground.jpg" Stretch="UniformToFill"/>

        <!-- A dark, semi-transparent layer on top of the image, so text and
             buttons stay easy to read no matter what's underneath them.
             Raise the last two alpha digits (currently "B3", ~70% opaque)
             for more contrast, or lower them to show more of the image. -->
        <Rectangle Fill="#B3101119"/>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Update notice: hidden unless a newer version is found at
             startup. Purely visual, no sound - and fully keyboard
             reachable (Tab to it; Enter on "Get It" opens the download
             page; Tab to "Dismiss" and press Enter/Space to hide it). -->
        <Border x:Name="UpdateNoticeBorder" Grid.Row="0" Background="{StaticResource AccentBrush}"
                CornerRadius="8" Padding="16,10" Margin="0,0,0,16" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UpdateNoticeText" Grid.Column="0" Text="A new version is available."
                           VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                <Button x:Name="UpdateGetItButton" Grid.Column="1" Content="_Get It" Style="{StaticResource SecondaryButton}"
                        Margin="12,0,8,0" Click="UpdateGetItButton_Click"
                        AutomationProperties.HelpText="Opens the download page for the new version in your browser."/>
                <Button x:Name="UpdateDismissButton" Grid.Column="2" Content="_Dismiss" Style="{StaticResource SecondaryButton}"
                        Click="UpdateDismissButton_Click"
                        AutomationProperties.HelpText="Hides this notice for now. It will check again next time the app starts."/>
            </Grid>
        </Border>

        <!-- Header -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Recording by Kyle Smith" Style="{StaticResource HeadingText}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="SettingsButton" Content="S_ettings" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0" Click="SettingsButton_Click"
                    AutomationProperties.HelpText="Choose where recordings are saved and what size to record at."/>
            <Button Grid.Column="2" x:Name="AboutButton" Content="_About" Style="{StaticResource SecondaryButton}"
                    Click="AboutButton_Click"
                    AutomationProperties.HelpText="Opens the About window with app information and copyright."/>
        </Grid>

        <!-- Center: recording indicator + timer -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Ellipse x:Name="IndicatorDot" Width="18" Height="18" Fill="{StaticResource TextSecondaryBrush}"
                         Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="IndicatorStateText" Text="Not recording" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="ElapsedTimeText" Text="00:00:00" Style="{StaticResource TimerText}"
                       HorizontalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,8">
                <Button x:Name="FullScreenSourceButton" Content="_Whole Screen" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0" Click="FullScreenSourceButton_Click"
                        AutomationProperties.HelpText="Records your whole primary monitor."/>
                <Button x:Name="WindowSourceButton" Content="A _Window" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0" Click="WindowSourceButton_Click"
                        AutomationProperties.HelpText="Opens a list of your open windows to choose one to record."/>
                <Button x:Name="RegionSourceButton" Content="Custom _Area" Style="{StaticResource SecondaryButton}"
                        Click="RegionSourceButton_Click"
                        AutomationProperties.HelpText="Lets you drag out a custom rectangle to record."/>
            </StackPanel>

            <TextBlock x:Name="SourceDescriptionText" Text="Recording: Whole screen (primary monitor)"
                       Style="{StaticResource BodyText}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Controls -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
            <Button x:Name="StartButton" Content="_Start Recording" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,16,0" Click="StartButton_Click"
                    AutomationProperties.HelpText="Asks for confirmation, then starts recording your whole screen."/>
            <Button x:Name="PauseButton" Content="_Pause Recording" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,16,0" Click="PauseButton_Click" IsEnabled="False"/>
            <Button x:Name="StopButton" Content="S_top Recording" Style="{StaticResource DangerButton}"
                    Click="StopButton_Click" IsEnabled="False"/>
        </StackPanel>

        <!-- Status bar: every status change is written here as plain text,
             never only announced through color or an icon. -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,24,0,0">
            <TextBlock x:Name="StatusMessageText" Text="Ready. Press Alt+S or click Start Recording to begin."
                       Style="{StaticResource StatusText}"/>
        </Border>
    </Grid>
    </Grid>
</Window>
